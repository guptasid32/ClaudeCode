# Copy to .env and adjust values. .env is gitignored.

# Path to the SQLite OLTP database (portfolio state, predictions, lots, etc.)
SQLITE_PATH=./data/state/imae.sqlite

# Path to the DuckDB analytics database (prices, financials, filings, cohort queries)
DUCKDB_PATH=./data/state/imae.duckdb

# Root directory for raw and processed data files
DATA_DIR=./data

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Python timezone used for as_of_date defaults (Asia/Kolkata for live use)
APP_TIMEZONE=Asia/Kolkata
